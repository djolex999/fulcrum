{
  "enabledPlugins": {
    "adapty-skills@adapty": false
  },
  "permissions": {
    "deny": [
      "Bash(adapty ab-tests archive:*)",
      "Bash(adapty ab-tests create:*)",
      "Bash(adapty ab-tests replace:*)",
      "Bash(adapty ab-tests start:*)",
      "Bash(adapty ab-tests stop:*)",
      "Bash(adapty ab-tests update:*)",
      "Bash(adapty access-levels create:*)",
      "Bash(adapty access-levels update:*)",
      "Bash(adapty apps create:*)",
      "Bash(adapty apps update:*)",
      "Bash(adapty apps get:*)",
      "Bash(adapty flows create:*)",
      "Bash(adapty flows update:*)",
      "Bash(adapty flows publish:*)",
      "Bash(adapty flows media upload:*)",
      "Bash(adapty flows config update:*)",
      "Bash(adapty migrations create:*)",
      "Bash(adapty migrations run:*)",
      "Bash(adapty migrations close:*)",
      "Bash(adapty paywalls create:*)",
      "Bash(adapty paywalls update:*)",
      "Bash(adapty placements create:*)",
      "Bash(adapty placements update:*)",
      "Bash(adapty product-groups create:*)",
      "Bash(adapty product-offers create:*)",
      "Bash(adapty product-offers update:*)",
      "Bash(adapty product-prices set:*)",
      "Bash(adapty products create:*)",
      "Bash(adapty products update:*)",
      "Bash(adapty products push:*)",
      "Bash(adapty segments create:*)",
      "Bash(adapty segments update:*)",
      "Bash(adapty asa ad-groups create:*)",
      "Bash(adapty asa ad-groups update:*)",
      "Bash(adapty asa ads create:*)",
      "Bash(adapty asa ads update:*)",
      "Bash(adapty asa automations create:*)",
      "Bash(adapty asa automations update:*)",
      "Bash(adapty asa automations run:*)",
      "Bash(adapty asa campaigns create:*)",
      "Bash(adapty asa campaigns update:*)",
      "Bash(adapty asa campaigns bulk-create:*)",
      "Bash(adapty asa connect:*)",
      "Bash(adapty asa keywords add:*)",
      "Bash(adapty asa keywords update:*)",
      "Bash(adapty asa negative-keywords add:*)",
      "Bash(adapty asa product-pages sync:*)",
      "Bash(adapty asa segments create:*)",
      "Bash(adapty asa segments update:*)",
      "Bash(adapty auth revoke:*)",
      "Bash(adapty feedback:*)",
      "mcp__plugin_adapty-skills_adapty__ab_tests_archive",
      "mcp__plugin_adapty-skills_adapty__ab_tests_create",
      "mcp__plugin_adapty-skills_adapty__ab_tests_replace",
      "mcp__plugin_adapty-skills_adapty__ab_tests_start",
      "mcp__plugin_adapty-skills_adapty__ab_tests_stop",
      "mcp__plugin_adapty-skills_adapty__ab_tests_update",
      "mcp__plugin_adapty-skills_adapty__access_levels_create",
      "mcp__plugin_adapty-skills_adapty__access_levels_update",
      "mcp__plugin_adapty-skills_adapty__apps_create",
      "mcp__plugin_adapty-skills_adapty__apps_update",
      "mcp__plugin_adapty-skills_adapty__flows_create",
      "mcp__plugin_adapty-skills_adapty__flows_update",
      "mcp__plugin_adapty-skills_adapty__flows_publish",
      "mcp__plugin_adapty-skills_adapty__flows_media_upload",
      "mcp__plugin_adapty-skills_adapty__flows_config_edit",
      "mcp__plugin_adapty-skills_adapty__flows_config_update",
      "mcp__plugin_adapty-skills_adapty__migrations_create",
      "mcp__plugin_adapty-skills_adapty__migrations_run",
      "mcp__plugin_adapty-skills_adapty__migrations_close",
      "mcp__plugin_adapty-skills_adapty__paywalls_create",
      "mcp__plugin_adapty-skills_adapty__paywalls_update",
      "mcp__plugin_adapty-skills_adapty__placements_create",
      "mcp__plugin_adapty-skills_adapty__placements_update",
      "mcp__plugin_adapty-skills_adapty__product_offers_create",
      "mcp__plugin_adapty-skills_adapty__product_offers_update",
      "mcp__plugin_adapty-skills_adapty__products_create",
      "mcp__plugin_adapty-skills_adapty__products_update",
      "mcp__plugin_adapty-skills_adapty__apps_get",
      "mcp__plugin_adapty-skills_adapty__feedback_send",
      "Read(../.env)",
      "Read(../.env.*)",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit"
    ],
    "blockWritesOutsideWorkingDirectories": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../.claude/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyWrite": [
        ".claude",
        ".mcp.json",
        "CLAUDE.md",
        "node_modules",
        "package.json",
        "tsconfig.json",
        "jsconfig.json",
        ".npmrc",
        ".env",
        ".env.*"
      ]
    }
  }
}
